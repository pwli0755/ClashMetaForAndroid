diff --git a/adapter/outbound/tailscale_cmfa.go b/adapter/outbound/tailscale_cmfa.go
new file mode 100644
index 00000000..952df5fc
--- /dev/null
+++ b/adapter/outbound/tailscale_cmfa.go
@@ -0,0 +1,32 @@
+//go:build cmfa && with_gvisor && !no_tailscale
+
+package outbound
+
+import (
+	"context"
+	"github.com/metacubex/tailscale/client/local"
+	D "github.com/miekg/dns"
+)
+
+// NewManagedTailscale keeps authentication URLs out of the application's log stream.
+func NewManagedTailscale(option TailscaleOption) (*Tailscale, error) {
+	t, err := NewTailscale(option)
+	if err != nil {
+		return nil, err
+	}
+	t.server.UserLogf = func(string, ...any) {}
+	t.server.Logf = func(string, ...any) {}
+	return t, nil
+}
+
+// ManagedClient exposes the embedded instance, never a machine-wide LocalAPI socket.
+func (t *Tailscale) ManagedClient() (*local.Client, error) {
+	if err := t.start(); err != nil {
+		return nil, err
+	}
+	return t.server.LocalClient()
+}
+
+func (t *Tailscale) ManagedDNS(ctx context.Context, msg *D.Msg) (*D.Msg, error) {
+	return (tailscaleDNSTransport{tailscale: t}).ExchangeContext(ctx, msg)
+}
diff --git a/adapter/outbound/reject_buffer_test.go b/adapter/outbound/reject_buffer_test.go
new file mode 100644
index 00000000..5d80ab51
--- /dev/null
+++ b/adapter/outbound/reject_buffer_test.go
@@ -0,0 +1,25 @@
+package outbound
+
+import (
+	"github.com/metacubex/mihomo/common/buf"
+	"io"
+	"testing"
+)
+
+func TestRejectWritersReleaseOwnedBuffers(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		write func(*buf.Buffer) error
+	}{
+		{"reject", (nopConn{}).WriteBuffer}, {"reject-drop", (dropConn{}).WriteBuffer},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			buffer := buf.New()
+			_, _ = buffer.Write([]byte("request"))
+			if err := tc.write(buffer); err != io.EOF {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			buffer.Leak() // debug builds panic here if the writer failed to release ownership
+		})
+	}
+}
diff --git a/dns/cmfa_tailnet.go b/dns/cmfa_tailnet.go
new file mode 100644
index 00000000..1b5cd314
--- /dev/null
+++ b/dns/cmfa_tailnet.go
@@ -0,0 +1,35 @@
+package dns
+
+import (
+	"context"
+	icontext "github.com/metacubex/mihomo/context"
+	D "github.com/miekg/dns"
+	"strings"
+	"sync/atomic"
+)
+
+var managedTailnet atomic.Pointer[string]
+
+type ManagedTailnetQuery func(context.Context, *D.Msg) (*D.Msg, error)
+
+var managedQuery atomic.Pointer[ManagedTailnetQuery]
+
+func SetManagedTailnetQuery(query ManagedTailnetQuery) { managedQuery.Store(&query) }
+
+// SetManagedTailnet reserves MagicDNS before hosts, fake-IP and resolver caches.
+func SetManagedTailnet(name string) { managedTailnet.Store(&name) }
+func withManagedTailnet(next handler) handler {
+	return func(ctx *icontext.DNSContext, request *D.Msg) (*D.Msg, error) {
+		name := managedTailnet.Load()
+		if name != nil && *name != "" && len(request.Question) > 0 {
+			host := strings.TrimSuffix(strings.ToLower(request.Question[0].Name), ".")
+			if host == "ts.net" || strings.HasSuffix(host, ".ts.net") {
+				if query := managedQuery.Load(); query != nil && *query != nil {
+					return (*query)(ctx, request)
+				}
+				return newTailscaleClient(*name).ExchangeContext(ctx, request)
+			}
+		}
+		return next(ctx, request)
+	}
+}
diff --git a/dns/cmfa_tailnet_test.go b/dns/cmfa_tailnet_test.go
new file mode 100644
index 00000000..9b55e703
--- /dev/null
+++ b/dns/cmfa_tailnet_test.go
@@ -0,0 +1,44 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	icontext "github.com/metacubex/mihomo/context"
+	D "github.com/miekg/dns"
+	"testing"
+)
+
+type guardedTestDNS struct{ calls int }
+
+func (c *guardedTestDNS) Address() string  { return "test" }
+func (c *guardedTestDNS) ResetConnection() {}
+func (c *guardedTestDNS) ExchangeContext(_ context.Context, _ *D.Msg) (*D.Msg, error) {
+	c.calls++
+	return nil, errors.New("offline")
+}
+
+func TestManagedTailnetDoesNotFallback(t *testing.T) {
+	client := &guardedTestDNS{}
+	unregister := RegisterTailscaleDnsClient("test-cmfa", client)
+	defer unregister()
+	SetManagedTailnet("test-cmfa")
+	defer SetManagedTailnet("")
+	fallback := 0
+	handler := withManagedTailnet(func(_ *icontext.DNSContext, m *D.Msg) (*D.Msg, error) { fallback++; return m, nil })
+	for _, qtype := range []uint16{D.TypeA, D.TypeAAAA, D.TypeHTTPS} {
+		msg := new(D.Msg)
+		msg.SetQuestion("host.tail.ts.net.", qtype)
+		_, err := handler(icontext.NewDNSContext(context.Background()), msg)
+		if err == nil || fallback != 0 {
+			t.Fatal("offline Tailnet DNS leaked to normal resolver")
+		}
+	}
+	msg := new(D.Msg)
+	msg.SetQuestion("example.org.", D.TypeA)
+	if _, err := handler(icontext.NewDNSContext(context.Background()), msg); err != nil || fallback != 1 {
+		t.Fatal("public DNS was redirected")
+	}
+	if client.calls != 3 {
+		t.Fatal("Tailnet DNS guard not used")
+	}
+}
diff --git a/tunnel/cmfa_policy.go b/tunnel/cmfa_policy.go
new file mode 100644
index 00000000..e36178f7
--- /dev/null
+++ b/tunnel/cmfa_policy.go
@@ -0,0 +1,22 @@
+package tunnel
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"sync/atomic"
+)
+
+type AppPolicy func(*C.Metadata) C.Proxy
+
+var appPolicy atomic.Pointer[AppPolicy]
+
+// SetAppPolicy installs CMFA's destination and application boundary before mode
+// or inbound overrides. Returning nil delegates to the subscription's rules.
+func SetAppPolicy(policy AppPolicy) { appPolicy.Store(&policy) }
+func applyAppPolicy(metadata *C.Metadata) C.Proxy {
+	if p := appPolicy.Load(); p != nil && *p != nil {
+		return (*p)(metadata)
+	}
+	return nil
+}
+
+func hasAppPolicy() bool { p := appPolicy.Load(); return p != nil && *p != nil }
